{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Powerhouse",
  "version": "0.1.0",
  "identifier": "dev.linuxpowerhouse.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Linux Powerhouse",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png"
    ],
    "category": "Utility",
    "shortDescription": "Powerful Linux. Simplified.",
    "longDescription": "Linux Powerhouse provides a safe, intuitive desktop experience for Linux system insights, diagnostics, monitoring, and explicitly confirmed actions."
  }
}
